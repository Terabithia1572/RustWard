# Rust
/target/
**/*.rs.bk

# Node / Tauri (Phase 6)
node_modules/
dist/
apps/*/src-tauri/target/
apps/*/src-tauri/gen/

# Local evidence and baselines may contain serial numbers / computer names
/evidence/
/baseline/
*.snapshot.local.json

# Databases and logs
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.log

# Secrets and signing material - never commit
*.pfx
*.p12
*.pem
*.key
*.cer
*.snk
.env
.env.*

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Offline build inputs (large, regenerated by scripts/vendor-offline.sh)
/vendor/
/.npm-offline-cache/
/.cargo-offline/
/release-out/
# Local Windows build logs (scripts/windows/Build-RustWard.ps1)
/build-logs/

# Local transfer and VM artifacts
*.bundle
*.iso
*.msi
*.exe
*.zip
*.vmdk
*.vmx
*.vmem
*.vmsd
*.vmxf
*.nvram
