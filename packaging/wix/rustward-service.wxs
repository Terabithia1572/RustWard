<?xml version="1.0" encoding="utf-8"?>
<!--
  WiX v3 fragment merged into the Tauri MSI by packaging/tauri.acceptance.conf.json.

  Installs rustward-service.exe next to the desktop app, registers it as an
  auto-start LocalSystem service and creates %ProgramData%\RustWard with a
  protected DACL (SYSTEM + BUILTIN\Administrators only).

  The service and notifier binary paths come from the TAURI_RUSTWARD_SERVICE_EXE
  and TAURI_RUSTWARD_NOTIFIER_EXE environment variables: tauri-bundler clears the
  WiX environment except SYSTEMROOT/TMP/TEMP and variables starting with TAURI
  (tauri-bundler 2.10.4, msi/mod.rs clear_env_for_wix). scripts/windows/Build-RustWard.ps1 sets them.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="RustWardServiceComponent" Guid="7C1E2A8B-3F4D-4E6A-9B21-5D8C0F3A7E11" Win64="yes">
        <File Id="RustWardServiceExe" Name="rustward-service.exe"
              Source="$(env.TAURI_RUSTWARD_SERVICE_EXE)" KeyPath="yes" Checksum="yes" />
        <ServiceInstall Id="RustWardServiceInstall"
                        Name="RustWardService"
                        DisplayName="RustWard USB Depolama Denetimi"
                        Description="Çevrimdışı USB depolama erişim denetimi ve Windows Grup İlkesi uygulama hizmeti (RustWard)."
                        Type="ownProcess" Start="auto" ErrorControl="normal"
                        Account="LocalSystem" Arguments="service" Vital="yes">
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="5"
                              ResetPeriodInDays="1" />
        </ServiceInstall>
        <ServiceControl Id="RustWardServiceControl" Name="RustWardService"
                        Start="install" Stop="both" Remove="uninstall" Wait="yes" />
        <!-- Event Log source. rustward-service.exe embeds the MESSAGETABLE
             generated from rustward-windows/src/eventlog_map.rs (build.rs), so
             Event Viewer formats every RustWard event ID. Removed with the
             component on uninstall. Registered ONLY by this installer, never
             by RustWard at runtime. -->
        <util:EventSource Log="Application" Name="RustWard"
                          EventMessageFile="[#RustWardServiceExe]"
                          SupportsErrors="yes" SupportsWarnings="yes"
                          SupportsInformationals="yes" />
      </Component>

      <Component Id="RustWardNotifierComponent" Guid="8E4C1B2A-9D3F-4A1E-B7C5-3F6D8A2E9C41" Win64="yes">
        <File Id="RustWardNotifierExe" Name="rustward-notifier.exe"
              Source="$(env.TAURI_RUSTWARD_NOTIFIER_EXE)" KeyPath="yes" Checksum="yes" />
        <!-- Launch the unprivileged per-session desktop notification agent at
             user logon outside Session 0. Uses ONLY PIPE_NAME_STATUS (read-only). -->
        <RegistryKey Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run">
          <RegistryValue Name="RustWardNotifier"
                         Type="string"
                         Value="&quot;[#RustWardNotifierExe]&quot;" />
        </RegistryKey>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="TARGETDIR">
      <Directory Id="CommonAppDataFolder">
        <Directory Id="RustWardDataDir" Name="RustWard">
          <!-- Permanent: audit data is kept on uninstall unless the administrator
               exports/removes it (docs/OFFLINE-DEPLOYMENT.md, uninstall). -->
          <Component Id="RustWardDataDirComponent" Guid="2B9F6D4E-8A13-4C57-B0E2-91F4A6C3D58E" Win64="yes" Permanent="yes">
            <CreateFolder>
              <PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" />
            </CreateFolder>
          </Component>
        </Directory>
      </Directory>
    </DirectoryRef>

    <!-- Attach explicit AppUserModelID to the all-users Start Menu shortcut
         so Windows Action Center associates rustward-notifier toasts with RustWard. -->
    <CustomTable Id="MsiShortcutProperty">
      <Column Id="MsiShortcutProperty" Type="string" Width="72" PrimaryKey="yes" />
      <Column Id="Shortcut_" Type="string" Width="72" />
      <Column Id="PropertyKey" Type="string" Width="255" />
      <Column Id="PropVariantValue" Type="string" Width="255" Nullable="yes" />
      <Row>
        <Data Column="MsiShortcutProperty">RustWardAppUserModelId</Data>
        <Data Column="Shortcut_">ApplicationStartMenuShortcut</Data>
        <Data Column="PropertyKey">System.AppUserModel.ID</Data>
        <Data Column="PropVariantValue">Terabithia.RustWard.Desktop</Data>
      </Row>
    </CustomTable>
  </Fragment>
</Wix>
